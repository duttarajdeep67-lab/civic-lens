# CivicLens Environment Configuration

# Application
PROJECT_NAME="CivicLens"
SECRET_KEY="civiclens-super-secret-development-key-change-in-production-2026"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database Configuration
# For local SQLite development (default):
DATABASE_URL="sqlite:///./civiclens.db"
# For PostgreSQL (Docker or production):
# DATABASE_URL="postgresql://civiclens:civiclens_secret_password@localhost:5432/civiclens"

# Google Gemini Vision AI Integration (MANDATORY PROVIDER)
# Replace with your Google Gemini API key:
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# Explicit Demo Mode (when true, uses clearly labeled simulation fallback if GEMINI_API_KEY is not set)
DEMO_MODE=true

# Storage
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE_MB=10
